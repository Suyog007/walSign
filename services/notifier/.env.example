# Sui network to watch: testnet | mainnet | devnet
SUI_NETWORK=testnet
# Optional custom fullnode URL (defaults to the public fullnode of SUI_NETWORK)
SUI_RPC_URL=
# Published wal_sign package ID (same value as VITE_PACKAGE_ID in the frontend)
WALSIGN_PACKAGE_ID=0x...

# Base URL of the WalSign web app, used for links in emails
APP_BASE_URL=http://localhost:5173

# JSON file mapping Sui addresses to email addresses (see contacts.example.json)
CONTACTS_FILE=./contacts.json
# Where the service remembers the last processed event and tracked deadlines
STATE_FILE=./notifier-state.json

# How often to poll for new events, and how early to warn about deadlines
POLL_INTERVAL_SECONDS=15
DEADLINE_WARNING_HOURS=24

# SMTP settings for outgoing mail
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="WalSign <no-reply@example.com>"
# Log emails instead of sending them
MAIL_DRY_RUN=true
